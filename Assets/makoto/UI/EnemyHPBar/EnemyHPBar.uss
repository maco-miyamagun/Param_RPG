:root {
}

#Base {
    background-color: #ffffffaa;
    align-items: center;

    flex-grow: 0;

    width: 100px;
    height: 30px;

    flex-direction: row;

    padding: 4px;

    position: absolute;

    border-radius: 2px;
}

#HPBarBase {
    background-color: #787d8a9d;

    width: 100%;
    height: 100%;

    flex-direction: row;
}

#HPBarEffect {
    background-color: #c93a3ad3;

    flex-grow: 0;

    width: 0%;
    height: 100%;

    max-width: 100%;
    max-height: 100%; 
}

#HPBar {
    background-color: #11e211d1;

    flex-grow: 0;

    width: 100%;
    height: 100%;

    max-width: 100%;
    max-height: 100%;
}