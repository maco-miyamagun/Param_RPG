:root {

}

#Base {
    background-color: #ffffffaa;
    align-items: center;

    flex-grow: 0;

    width: 50%;
    height: 10%;

    max-height: 10%;

    flex-direction: row;

    padding: 10px;

    position: absolute;
    top: 15%;
    left: 2%;

    border-radius: 10px;
}

#Name {
    -unity-text-align: middle-left;

    font-size: 20px;
    -unity-font-style: bold;
}

#HPBar {
    background-color: #3ac962aa;

    flex-grow: 0;

    width: 80%;
    height: 90%;

    max-width: 100%;
    max-height: 80%;
}