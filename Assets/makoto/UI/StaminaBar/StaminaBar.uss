:root {
}

#Base {
    background-color: rgba(255, 255, 255, 0.67);
    align-items: center;
    flex-grow: 0;
    width: 10%;
    height: 5%;
    max-height: 5%;
    flex-direction: row;
    padding: 4px;
    position: absolute;
    top: 35%;
    left: 40%;
    border-radius: 2px;
}

#StaminaBarBase {
    background-color: rgba(120, 125, 138, 0.62);
    width: 100%;
    height: 100%;
    justify-content: center;
}

#StaminaBar {
    background-color: rgba(241, 168, 22, 0.82);
    flex-grow: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
}


