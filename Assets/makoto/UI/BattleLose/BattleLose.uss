#BG {
    background-color: #2b2b2bef;
    align-items: center;

    width: 100%;
    height: 100%;
}

#Container {
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;
}

#Name {
    -unity-text-align: middle-left;
    color:  #d8d6d6;

    font-size: 80px;
    -unity-font-style: bold;
}

#Discription {
    -unity-text-align: middle-left;
    color:  #c75454;

    font-size: 40px;
    -unity-font-style: bold;
}