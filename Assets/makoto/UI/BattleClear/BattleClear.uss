#BG {
    background-color: #2b2b2bef;
    align-items: center;

    width: 100%;
    height: 100%;
}

#Container {
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;
}

#Name {
    -unity-text-align: middle-left;
    color:  #d8d6d6;

    font-size: 80px;
    -unity-font-style: bold;
}

#Discription {
    -unity-text-align: middle-left;
    color:  #c75454;

    font-size: 40px;
    -unity-font-style: bold;
}

#Level {
    -unity-text-align: middle-left;
    color:  #2e2e2e;

    font-size: 30px;
    -unity-font-style: bold;
}

#Base {
    background-color: #e68f42d3;
    align-items: center;

    flex-grow: 0;

    width: 30%;
    height: 10%;

    max-height: 15%;

    flex-direction: row;

    padding: 6px;

    border-radius: 10px;
    margin: 5%;
}

#EXPBarBase {
    background-color: #4d4a4a97;

    width: 100%;
    height: 100%;

    flex-direction: row;
}

#EXPBar {
    background-color: #3ac962aa;

    flex-grow: 0;

    width: 100%;
    height: 100%;

    max-width: 100%;
    max-height: 100%;
}