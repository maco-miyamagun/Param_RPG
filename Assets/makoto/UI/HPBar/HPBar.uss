:root {

}

#Base {
    background-color: #ffffffaa;
    align-items: center;

    flex-grow: 0;

    width: 30%;
    height: 6%;

    max-height: 6%;

    flex-direction: row;

    padding: 6px;

    position: absolute;
    top: 3%;
    left: 2%;

    border-radius: 10px;
}

#Name {
    -unity-text-align: middle-left;

    font-size: 15px;
    -unity-font-style: bold;
}

#HPBarBase {
    background-color: #4d4a4a97;

    width: 100%;
    height: 100%;

    flex-direction: row;
}

#HPBarEffect {
    background-color: #c93a3ad3;

    flex-grow: 0;

    width: 0%;
    height: 100%;

    max-width: 100%;
    max-height: 100%;  
}

#HPBar {
    background-color: #3ac962aa;

    flex-grow: 0;

    width: 100%;
    height: 100%;

    max-width: 100%;
    max-height: 100%;
}